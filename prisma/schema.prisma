// ============================================================
// DocQuery — Prisma Schema
// Phase 1: Authentication & Multi-Tenancy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================
// User
// ============================================================
// Core identity model. A user can belong to multiple
// organizations via OrganizationMember (junction table).
// organizationId is intentionally NOT on this model.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  documents     Document[]
  conversations Conversation[]

  @@map("users")
}

// ============================================================
// Organization
// ============================================================
// Represents a tenant / workspace. All future resources
// (documents, queries, etc.) will be scoped to an organization.

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships        OrganizationMember[]
  documents          Document[]
  conversations      Conversation[]
  evaluationDatasets EvaluationDataset[]
  evaluationRuns     EvaluationRun[]

  @@map("organizations")
}

// ============================================================
// OrganizationMember (Junction Table)
// ============================================================
// Links users to organizations with a specific role.
// The @@unique constraint prevents duplicate memberships
// at the database level.

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations — cascade delete when User or Organization is removed
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ============================================================
// RefreshToken
// ============================================================
// Persisted refresh tokens enable secure logout (revocation),
// token replay detection, and future refresh-token rotation.

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ============================================================
// Document
// ============================================================
// Represents an uploaded document scoped to an organization (tenant).

model Document {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  name               String
  filePath           String         @map("file_path")
  fileSize           Int            @map("file_size")
  mimeType           String         @map("mime_type")
  status             DocumentStatus @default(UPLOADED)
  errorMessage       String?        @map("error_message")
  processingAttempts Int            @default(0) @map("processing_attempts")
  pageCount          Int?           @map("page_count")
  metadata           Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  messageSources MessageSource[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("documents")
}

// ============================================================
// DocumentChunk
// ============================================================
// Represents a chunk of extracted text with its vector embedding.

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @map("document_id") @db.Uuid
  content    String
  chunkIndex Int                          @map("chunk_index")
  pageNumber Int?                         @map("page_number")
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================================
// Conversation
// ============================================================
// Represents a multi-turn conversation session owned by a user
// within an organization.

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([createdAt])
  @@map("conversations")
}

// ============================================================
// Message
// ============================================================
// Represents a single turn (user or assistant) in a conversation.

model Message {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources      MessageSource[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// MessageSource
// ============================================================
// Persisted source/citation metadata associated with an assistant message.

model MessageSource {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  chunkId      String   @map("chunk_id") @db.Uuid
  documentName String?  @map("document_name")
  pageNumber   Int?     @map("page_number")
  content      String
  score        Float?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([documentId])
  @@map("message_sources")
}

// ============================================================
// Phase 8: RAG Evaluation Models
// ============================================================

// ── EvaluationDataset ──
// Represents a curated set of test questions/cases scoped to an organization.
model EvaluationDataset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        EvaluationCase[]
  runs         EvaluationRun[]

  @@index([organizationId])
  @@map("evaluation_datasets")
}

// ── EvaluationCase ──
// Represents an individual test query with ground truth answer/sources.
model EvaluationCase {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  question        String
  expectedAnswer  String?  @map("expected_answer")
  expectedSources Json?    @map("expected_sources") // Array of document IDs / chunk IDs
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@index([datasetId])
  @@map("evaluation_cases")
}

// ── EvaluationRun ──
// Represents an execution of an evaluation dataset against the RAG pipeline.
model EvaluationRun {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  datasetId      String           @map("dataset_id") @db.Uuid
  status         EvaluationStatus @default(PENDING)
  config         Json?            // Pipeline settings used for run
  metrics        Json?            // Aggregated scores (Precision@K, Recall@K, MRR, Faithfulness, Relevance)
  totalCases     Int              @default(0) @map("total_cases")
  completedCases Int              @default(0) @map("completed_cases")
  latencyMs      Int?             @map("latency_ms")
  tokenUsage     Json?            @map("token_usage")
  errorMessage   String?          @map("error_message")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([organizationId])
  @@index([datasetId])
  @@index([organizationId, status])
  @@map("evaluation_runs")
}

// ── EvaluationResult ──
// Detailed evaluation outputs for a specific question within a run.
model EvaluationResult {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  question        String
  generatedAnswer String?  @map("generated_answer")
  retrievedChunks Json?    @map("retrieved_chunks")
  citations       Json?
  scores          Json?    // { precisionAtK, recallAtK, mrr, hitRate, faithfulness, relevance, contextUtilization }
  latencyMs       Int?     @map("latency_ms")
  passed          Boolean  @default(true)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  run  EvaluationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([caseId])
  @@map("evaluation_results")
}



