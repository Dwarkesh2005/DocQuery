# ============================================================
# DocQuery — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── Database ──
DATABASE_URL="postgresql://postgres:password@localhost:5432/DocQuery?schema=public"

# ── JWT ──
JWT_ACCESS_SECRET="your-access-secret-minimum-16-characters"
JWT_REFRESH_SECRET="your-refresh-secret-minimum-16-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ──
PORT=3000
NODE_ENV="development"

# ── Password Hashing ──
BCRYPT_SALT_ROUNDS=12

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Rate Limiting ──
# Auth endpoints: strict limits (10 requests per 15 minutes)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900
# General API endpoints (100 requests per 15 minutes)
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=900
# Heavy operations (20 requests per 15 minutes)
RATE_LIMIT_HEAVY_MAX=20
RATE_LIMIT_HEAVY_WINDOW=900

# ── Logging ──
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"

# ── Phase 3: Document Intelligence & Embedding Pipeline ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY="sk-..."
UPLOAD_DIR="./uploads"

# ── Phase 4: Semantic Search ──
SEARCH_SIMILARITY_THRESHOLD=0.2
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=20

# ── Phase 5: RAG Answer Generation ──
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
