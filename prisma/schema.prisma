// ============================================================
// DocQuery — Prisma Schema
// Phase 9: Enterprise Intelligence, Security & Scale
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PermissionGranteeType {
  USER
  ROLE
  ORGANIZATION
}

enum PermissionLevel {
  READ
  WRITE
  ADMIN
}

enum QuotaPlan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

// ============================================================
// User
// ============================================================
// Core identity model. A user can belong to multiple
// organizations via OrganizationMember (junction table).

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships         OrganizationMember[]
  refreshTokens       RefreshToken[]
  documents           Document[]
  conversations       Conversation[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  documentPermissions DocumentPermission[]
  documentVersions    DocumentVersion[]

  @@map("users")
}

// ============================================================
// Organization
// ============================================================
// Represents an enterprise tenant / workspace.

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships          OrganizationMember[]
  documents            Document[]
  conversations        Conversation[]
  evaluationDatasets   EvaluationDataset[]
  evaluationRuns       EvaluationRun[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  entities             Entity[]
  entityRelations      EntityRelation[]
  usageRecords         UsageRecord[]
  usageDailyAggregates UsageDailyAggregate[]
  quota                OrganizationQuota?

  @@map("organizations")
}

// ============================================================
// OrganizationMember (Junction Table)
// ============================================================
// Links users to organizations with a specific role.

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ============================================================
// RefreshToken
// ============================================================

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ============================================================
// Document
// ============================================================
// Represents an uploaded document scoped to an organization.

model Document {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  name               String
  filePath           String         @map("file_path")
  fileSize           Int            @map("file_size")
  mimeType           String         @map("mime_type")
  contentHash        String?        @map("content_hash")
  status             DocumentStatus @default(UPLOADED)
  errorMessage       String?        @map("error_message")
  processingAttempts Int            @default(0) @map("processing_attempts")
  pageCount          Int?           @map("page_count")
  metadata           Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  messageSources MessageSource[]
  permissions    DocumentPermission[]
  versions       DocumentVersion[]
  intelligence   DocumentIntelligence?

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([contentHash])
  @@map("documents")
}

// ============================================================
// DocumentChunk
// ============================================================

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @map("document_id") @db.Uuid
  content    String
  chunkIndex Int                          @map("chunk_index")
  pageNumber Int?                         @map("page_number")
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================================
// Conversation
// ============================================================

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([createdAt])
  @@map("conversations")
}

// ============================================================
// Message
// ============================================================

model Message {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources      MessageSource[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// MessageSource
// ============================================================

model MessageSource {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  chunkId      String   @map("chunk_id") @db.Uuid
  documentName String?  @map("document_name")
  pageNumber   Int?     @map("page_number")
  content      String
  score        Float?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([documentId])
  @@map("message_sources")
}

// ============================================================
// Phase 8: RAG Evaluation Models
// ============================================================

model EvaluationDataset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        EvaluationCase[]
  runs         EvaluationRun[]

  @@index([organizationId])
  @@map("evaluation_datasets")
}

model EvaluationCase {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  question        String
  expectedAnswer  String?  @map("expected_answer")
  expectedSources Json?    @map("expected_sources")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@index([datasetId])
  @@map("evaluation_cases")
}

model EvaluationRun {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  datasetId          String           @map("dataset_id") @db.Uuid
  status             EvaluationStatus @default(PENDING)
  config             Json?
  metrics            Json?
  regressionDetected Boolean          @default(false) @map("regression_detected")
  totalCases         Int              @default(0) @map("total_cases")
  completedCases     Int              @default(0) @map("completed_cases")
  latencyMs          Int?             @map("latency_ms")
  tokenUsage         Json?            @map("token_usage")
  errorMessage       String?          @map("error_message")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([organizationId])
  @@index([datasetId])
  @@index([organizationId, status])
  @@map("evaluation_runs")
}

model EvaluationResult {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  question        String
  generatedAnswer String?  @map("generated_answer")
  retrievedChunks Json?    @map("retrieved_chunks")
  citations       Json?
  scores          Json?
  latencyMs       Int?     @map("latency_ms")
  passed          Boolean  @default(true)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  run  EvaluationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([caseId])
  @@map("evaluation_results")
}

// ============================================================
// Phase 9: Enterprise Models
// ============================================================

// ── DocumentPermission ──
// Resource-level access control for documents.
model DocumentPermission {
  id          String                @id @default(uuid()) @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  granteeType PermissionGranteeType @map("grantee_type")
  granteeId   String?               @map("grantee_id") @db.Uuid
  granteeRole OrganizationRole?     @map("grantee_role")
  permission  PermissionLevel       @default(READ)
  createdAt   DateTime              @default(now()) @map("created_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([granteeId])
  @@index([documentId, granteeType])
  @@map("document_permissions")
}

// ── ApiKey ──
// Developer API keys with scopes, hashing, expiration, and revocation.
model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  hashedSecret   String    @map("hashed_secret")
  scopes         Json      // Array of granted scope strings
  expiresAt      DateTime? @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

// ── DocumentVersion ──
// Tracks historical revisions of documents with content checksums.
model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNumber Int      @map("version_number")
  contentHash   String   @map("content_hash")
  filePath      String   @map("file_path")
  fileSize      Int      @map("file_size")
  summary       String?
  metadata      Json?
  queryable     Boolean  @default(true)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([contentHash])
  @@map("document_versions")
}

// ── DocumentIntelligence ──
// Extracted metadata, title, language, classification, summary, and sections.
model DocumentIntelligence {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @unique @map("document_id") @db.Uuid
  title          String?
  language       String?  @default("en")
  classification String?
  summary        String?
  sections       Json?    // Array of detected section objects
  entities       Json?    // Extracted named entities
  keywords       Json?    // Extracted key phrases
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_intelligence")
}

// ── Knowledge Graph: Entity ──
model Entity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  type           String   // e.g. "CONCEPT", "TECHNOLOGY", "ORGANIZATION", "PERSON"
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceOf     EntityRelation[] @relation("SourceEntity")
  targetOf     EntityRelation[] @relation("TargetEntity")

  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@index([name])
  @@map("entities")
}

// ── Knowledge Graph: EntityRelation ──
model EntityRelation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceEntityId String   @map("source_entity_id") @db.Uuid
  targetEntityId String   @map("target_entity_id") @db.Uuid
  relationType   String   @map("relation_type") // e.g. "USES", "DEVELOPED_BY", "RELATED_TO"
  confidence     Float    @default(1.0)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceEntity Entity       @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity       @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceEntityId, targetEntityId, relationType])
  @@index([organizationId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("entity_relations")
}

// ── AuditLog ──
// Immutable audit trail for compliance.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ── UsageRecord ──
// Event-level usage accounting for metering and billing.
model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  eventType      String   @map("event_type") // "QUERY", "EMBEDDING", "STORAGE", "API_REQUEST", "LLM_TOKENS"
  quantity       Int      @default(1)
  units          String   // "COUNT", "TOKENS", "BYTES"
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventType])
  @@index([organizationId, createdAt])
  @@map("usage_records")
}

// ── UsageDailyAggregate ──
// Daily rolled-up metrics for rapid quota checks and dashboarding.
model UsageDailyAggregate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  date           String   // YYYY-MM-DD
  queriesCount   Int      @default(0) @map("queries_count")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  embeddingsCount Int     @default(0) @map("embeddings_count")
  storageBytes   BigInt   @default(0) @map("storage_bytes")
  apiRequests    Int      @default(0) @map("api_requests")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@map("usage_daily_aggregates")
}

// ── OrganizationQuota ──
// Configurable tenant limits based on pricing tiers.
model OrganizationQuota {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @unique @map("organization_id") @db.Uuid
  plan               QuotaPlan @default(FREE)
  maxDocuments       Int       @default(100) @map("max_documents")
  maxStorageBytes    BigInt    @default(524288000) @map("max_storage_bytes") // 500MB
  maxQueriesPerMonth Int       @default(1000) @map("max_queries_per_month")
  maxTokensPerMonth  Int       @default(1000000) @map("max_tokens_per_month")
  maxApiRequests     Int       @default(10000) @map("max_api_requests")
  maxMembers         Int       @default(5) @map("max_members")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_quotas")
}
