// ============================================================
// DocQuery — Prisma Schema
// Phase 1: Authentication & Multi-Tenancy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================================
// User
// ============================================================
// Core identity model. A user can belong to multiple
// organizations via OrganizationMember (junction table).
// organizationId is intentionally NOT on this model.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ============================================================
// Organization
// ============================================================
// Represents a tenant / workspace. All future resources
// (documents, queries, etc.) will be scoped to an organization.

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships OrganizationMember[]

  @@map("organizations")
}

// ============================================================
// OrganizationMember (Junction Table)
// ============================================================
// Links users to organizations with a specific role.
// The @@unique constraint prevents duplicate memberships
// at the database level.

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations — cascade delete when User or Organization is removed
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================
// RefreshToken
// ============================================================
// Persisted refresh tokens enable secure logout (revocation),
// token replay detection, and future refresh-token rotation.

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}
