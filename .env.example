# ============================================================
# DocQuery — Environment Configuration Template
# Phase 10: Production Deployment, SRE & Reliability
# ============================================================

# ── Application & Runtime ──
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://app.yourdomain.com
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000

# ── Database (PostgreSQL 16 + pgvector) ──
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/docquery?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=10000

# ── Redis (Cache, BullMQ, Rate Limiting) ──
REDIS_URL=redis://localhost:6379
REDIS_RETRY_STRATEGY_MAX_MS=3000

# ── Authentication & JWT ──
JWT_ACCESS_SECRET=your_super_secret_access_key_min_16_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_16_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Rate Limiting ──
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=900
RATE_LIMIT_HEAVY_MAX=20
RATE_LIMIT_HEAVY_WINDOW=900

# ── Document Chunking & Embeddings ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=sk-your-openai-api-key-here
UPLOAD_DIR=./uploads

# ── Search & Retrieval ──
SEARCH_SIMILARITY_THRESHOLD=0.2
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=20
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_REWRITE=true
ENABLE_RERANKING=true
RERANKER_PROVIDER=score
COHERE_API_KEY=
RRF_K_CONSTANT=60

# ── LLM Generation & Context ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
DEFAULT_ANSWER_MODE=STRICT
MAX_CONTEXT_CHUNKS=10
MAX_CONTEXT_TOKENS=3000
RAG_CACHE_TTL_SECONDS=3600
CONVERSATION_HISTORY_LIMIT=10
