// ============================================================
// DocQuery — Prisma Schema
// Phase 1: Authentication & Multi-Tenancy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

// ============================================================
// User
// ============================================================
// Core identity model. A user can belong to multiple
// organizations via OrganizationMember (junction table).
// organizationId is intentionally NOT on this model.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  documents     Document[]
  conversations Conversation[]

  @@map("users")
}

// ============================================================
// Organization
// ============================================================
// Represents a tenant / workspace. All future resources
// (documents, queries, etc.) will be scoped to an organization.

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  memberships   OrganizationMember[]
  documents     Document[]
  conversations Conversation[]

  @@map("organizations")
}

// ============================================================
// OrganizationMember (Junction Table)
// ============================================================
// Links users to organizations with a specific role.
// The @@unique constraint prevents duplicate memberships
// at the database level.

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations — cascade delete when User or Organization is removed
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ============================================================
// RefreshToken
// ============================================================
// Persisted refresh tokens enable secure logout (revocation),
// token replay detection, and future refresh-token rotation.

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

// ============================================================
// Document
// ============================================================
// Represents an uploaded document scoped to an organization (tenant).

model Document {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  name               String
  filePath           String         @map("file_path")
  fileSize           Int            @map("file_size")
  mimeType           String         @map("mime_type")
  status             DocumentStatus @default(UPLOADED)
  errorMessage       String?        @map("error_message")
  processingAttempts Int            @default(0) @map("processing_attempts")
  pageCount          Int?           @map("page_count")
  metadata           Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  messageSources MessageSource[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("documents")
}

// ============================================================
// DocumentChunk
// ============================================================
// Represents a chunk of extracted text with its vector embedding.

model DocumentChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @map("document_id") @db.Uuid
  content    String
  chunkIndex Int                          @map("chunk_index")
  pageNumber Int?                         @map("page_number")
  metadata   Json?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================================
// Conversation
// ============================================================
// Represents a multi-turn conversation session owned by a user
// within an organization.

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([createdAt])
  @@map("conversations")
}

// ============================================================
// Message
// ============================================================
// Represents a single turn (user or assistant) in a conversation.

model Message {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources      MessageSource[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// MessageSource
// ============================================================
// Persisted source/citation metadata associated with an assistant message.

model MessageSource {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  chunkId      String   @map("chunk_id") @db.Uuid
  documentName String?  @map("document_name")
  pageNumber   Int?     @map("page_number")
  content      String
  score        Float?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([documentId])
  @@map("message_sources")
}


